# Sample dev/test environment variables
POSTGRES_DB=todo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optionally override app-specific settings (defaults already in application.yaml)
DB_NAME=todo_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432
DB_SSL=disable

# JWT
JWT_SECRET=change-me-in-prod

# Logging
LOG_LEVEL=INFO
